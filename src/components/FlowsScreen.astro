---
// Recreated from FlowsView and the five starter classes in SampleFlows.swift.
const flows = [
  { name: 'Bodyweight Tone', meta: '11 segments · 38 movements' },
  { name: 'Arms and Core', meta: '11 segments · 38 movements' },
  { name: 'Legs and Glutes', meta: '11 segments · 37 movements' },
  { name: 'Beam Flow', meta: '10 segments · 33 movements' },
  { name: 'Dumbbell Flow', meta: '10 segments · 38 movements' },
];
---
<div class="flows" data-screen="flows">
  <div class="head">
    <p class="kicker">Your classes</p>
    <div class="title">
      <h3>Flows</h3>
      <span class="new">+ New class</span>
    </div>
  </div>
  <div class="areas" aria-hidden="true"><span class="on">All · 5</span></div>
  <div class="list">
    {flows.map((flow) => (
      <div class="card">
        <b>{flow.name}</b>
        <small>{flow.meta}</small>
      </div>
    ))}
  </div>
</div>

<style>
  .flows { display: flex; flex-direction: column; gap: 8px; }
  .head .kicker { font-size: 10px; letter-spacing: 0.16em; }
  .title { display: flex; align-items: center; justify-content: space-between; }
  .title h3 { font-size: 28px; letter-spacing: -0.045em; }
  .new {
    font-size: 11px; font-weight: 500; padding: 6px 10px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 247, 240, 0.07);
  }
  .areas span {
    display: inline-flex; font-size: 11px; border-radius: 999px; padding: 5px 8px;
    background: var(--ember-gradient); color: #fff;
  }
  .list { display: grid; gap: 8px; }
  .card {
    border-radius: 16px; padding: 10px 12px;
    background: rgba(255, 247, 240, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .card b { display: block; font-size: 14px; font-weight: 600; letter-spacing: -0.03em; }
  .card small { display: block; margin-top: 2px; font-size: 11px; color: var(--muted); }
</style>
