---
import { SITE } from '../site';
import { FEATURES_ENABLED } from '../lib/featuresFlag.js';
const year = new Date().getFullYear();
---
<footer class="wrap">
  <div class="top">
    <div>
      <span class="wordmark">sculpt cues</span>
      <p class="muted">{SITE.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <a href="/about/">About</a>
      {FEATURES_ENABLED && <a href="/features/">Featured</a>}
      <a href="/blog/">Journal</a>
      <a href="/support/">Support</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a class="ig" href={SITE.instagram} target="_blank" rel="noopener" aria-label="Sculpt Cues on Instagram">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </nav>
  </div>
  <p class="fine">© {year} Sculpt Cues. iPhone and App Store are trademarks of Apple Inc.</p>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding: 44px 0 40px; margin-top: 40px; }
  .top { display: flex; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
  .wordmark { font-size: 26px; color: #fff; }
  .top p { margin-top: 6px; font-size: 14px; }
  nav { display: flex; gap: 22px; flex-wrap: wrap; align-items: center; }
  nav a { color: var(--muted); text-decoration: none; font-size: 14px; }
  nav a:hover { color: var(--cream); }
  .ig { display: inline-flex; align-items: center; }
  .fine { margin-top: 30px; color: var(--faint); font-size: 12px; }
</style>
