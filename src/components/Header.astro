---
const path = Astro.url.pathname;
const links = [
  { href: '/#notify', label: 'Subscribe' },
  { href: '/blog/', label: 'Blogs', on: path.startsWith('/blog') },
  { href: '/support/', label: 'Support', on: path.startsWith('/support') },
];
---
<header class="site-header">
  <nav class="bar glass wrap" aria-label="Main">
    <a href="/" class="brand" aria-label="Sculpt Cues home">
      <img src="/img/icon.webp" alt="" width="30" height="30" />
      <span class="wordmark">sculpt cues</span>
    </a>
    <ul>
      {links.map((l) => (
        <li><a href={l.href} class:list={{ on: l.on }}>{l.label}</a></li>
      ))}
    </ul>
    <a class="get btn btn-primary" href="/#pricing">Get App</a>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 14px; z-index: 50; padding: 0 0; }
  .bar {
    display: flex; align-items: center; gap: 18px;
    border-radius: 999px; padding: 8px 8px 8px 12px;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { border-radius: 8px; }
  .brand .wordmark { font-size: 21px; color: #fff; }
  ul { display: flex; gap: 4px; list-style: none; margin-left: auto; }
  ul a {
    display: block; padding: 9px 14px; border-radius: 999px; font-size: 14px;
    color: var(--muted); text-decoration: none; transition: color 0.15s, background 0.15s;
  }
  ul a:hover, ul a.on { color: #fff; background: rgba(255, 247, 240, 0.12); }
  .get { padding: 10px 18px; font-size: 14px; box-shadow: none; }
  @media (max-width: 760px) {
    ul { display: none; }
    .get { margin-left: auto; }
  }
</style>
