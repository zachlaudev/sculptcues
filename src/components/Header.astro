---
import { appStoreCampaignUrl } from '../site';
import { FEATURES_ENABLED } from '../lib/featuresFlag.js';
const path = Astro.url.pathname;
function active(href: string) {
  const base = href.replace(/\/$/, '');
  return path === href || path === base || path.startsWith(`${base}/`);
}
const instructorLinks = [
  { href: '/cue-coach/', label: 'Cue Coach' },
  { href: '/barre-class-planner/', label: 'Barre planner' },
  { href: '/mat-pilates-sequence-builder/', label: 'Mat Pilates' },
  { href: '/sample-flows/', label: 'Sample Flows' },
];
const links = [
  { href: '/subscribe/', label: 'Subscribe', on: active('/subscribe/') },
  ...(FEATURES_ENABLED ? [{ href: '/features/', label: 'Featured', on: active('/features/') }] : []),
  { href: '/blog/', label: 'Blog', on: active('/blog/') },
  { href: '/support/', label: 'Support', on: active('/support/') },
];
const instructorOn = instructorLinks.some((l) => active(l.href));
---
<header class="site-header">
  <nav class="bar glass wrap" aria-label="Main">
    <a href="/" class="brand" aria-label="Sculpt Cues home">
      <img src="/img/icon.webp" alt="" width="30" height="30" />
      <span class="wordmark">sculpt cues</span>
    </a>
    <ul class="nav-links" id="site-nav">
      <li class="has-menu">
        <button
          type="button"
          class:list={['menu-btn', { on: instructorOn }]}
          id="for-instructors-button"
          aria-expanded="false"
          aria-controls="for-instructors"
          aria-haspopup="true"
        >
          For Instructors
          <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2.2 4.2 L6 8 L9.8 4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="submenu glass" id="for-instructors" aria-label="For Instructors" hidden>
          {instructorLinks.map((l) => (
            <li>
              <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
      </li>
      {links.map((l) => (
        <li><a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <button type="button" class="nav-toggle glass" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <svg class="icon-open" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M3 5h12M3 9h12M3 13h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M4.5 4.5l9 9M13.5 4.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
    <a class="get btn btn-primary" href={appStoreCampaignUrl('site-header')} data-app-store>Get App</a>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  const toggleLabel = toggle?.querySelector('.sr-only');
  const menu = header?.querySelector('.has-menu');
  const button = header?.querySelector('#for-instructors-button');
  const submenu = header?.querySelector('#for-instructors');
  if (!header || !toggle || !toggleLabel || !menu || !button || !submenu) throw new Error('Header markup missing');

  const mq = window.matchMedia('(max-width: 860px)');
  const itemLinks = () => [...submenu.querySelectorAll('a')];

  function setExpanded(el, open) {
    el.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function closeSub() {
    setExpanded(button, false);
    submenu.hidden = true;
  }

  function openSub() {
    setExpanded(button, true);
    submenu.hidden = false;
  }

  function closeMobile() {
    header.classList.remove('is-open');
    setExpanded(toggle, false);
    toggleLabel.textContent = 'Menu';
  }

  function openMobile() {
    header.classList.add('is-open');
    setExpanded(toggle, true);
    toggleLabel.textContent = 'Close menu';
  }

  toggle.addEventListener('click', () => {
    if (header.classList.contains('is-open')) closeMobile();
    else openMobile();
  });

  button.addEventListener('click', () => {
    if (button.getAttribute('aria-expanded') === 'true') closeSub();
    else openSub();
  });

  button.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      openSub();
      itemLinks()[0]?.focus();
    }
  });

  submenu.addEventListener('keydown', (e) => {
    const list = itemLinks();
    const index = list.indexOf(document.activeElement);
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      list[index < 0 ? 0 : (index + 1) % list.length]?.focus();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (index <= 0) button.focus();
      else list[index - 1].focus();
    } else if (e.key === 'Home') {
      e.preventDefault();
      list[0]?.focus();
    } else if (e.key === 'End') {
      e.preventDefault();
      list.at(-1)?.focus();
    }
  });

  menu.addEventListener('focusout', (e) => {
    if (!menu.contains(e.relatedTarget)) closeSub();
  });

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node) || header.contains(e.target)) return;
    closeSub();
    closeMobile();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (button.getAttribute('aria-expanded') === 'true') {
      closeSub();
      button.focus();
      return;
    }
    if (header.classList.contains('is-open')) {
      closeMobile();
      toggle.focus();
    }
  });

  mq.addEventListener('change', () => {
    if (!mq.matches) closeMobile();
  });
</script>

<style>
  .site-header { position: sticky; top: 14px; z-index: 50; }
  .bar {
    position: relative;
    display: flex; align-items: center; gap: 18px;
    border-radius: 999px; padding: 8px 8px 8px 12px;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { border-radius: 8px; }
  .brand .wordmark { font-size: 21px; color: #fff; }
  .nav-links { display: flex; gap: 4px; list-style: none; margin-left: auto; align-items: center; }
  .nav-links a, .menu-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 14px; border-radius: 999px; font-size: 14px;
    color: var(--muted); text-decoration: none; transition: color 0.15s, background 0.15s;
    background: none; border: 0; font-family: inherit; cursor: pointer; line-height: 1.2;
  }
  .nav-links a:hover, .nav-links a.on, .menu-btn:hover, .menu-btn.on, .menu-btn[aria-expanded="true"] {
    color: #fff; background: rgba(255, 247, 240, 0.12);
  }
  .chev { transition: transform 0.15s ease; }
  .menu-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .has-menu { position: relative; }
  .submenu {
    position: absolute; top: calc(100% + 12px); left: 0; min-width: 220px;
    margin: 0; padding: 8px; border-radius: 18px; list-style: none;
    display: grid; gap: 2px; z-index: 60;
    background: #160c0c;
  }
  .submenu[hidden] { display: none !important; }
  .submenu a { display: block; border-radius: 12px; white-space: nowrap; }
  .nav-toggle {
    display: none; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 999px; border: 0; padding: 0;
    color: var(--cream); background: transparent; cursor: pointer;
  }
  .nav-toggle .icon-close { display: none; }
  .site-header.is-open .nav-toggle .icon-open { display: none; }
  .site-header.is-open .nav-toggle .icon-close { display: block; }
  .get { padding: 10px 18px; font-size: 14px; box-shadow: none; }
  @media (max-width: 860px) {
    .nav-toggle { display: inline-flex; margin-left: auto; }
    .nav-links {
      display: none;
      position: absolute; top: calc(100% + 10px); left: 0; right: 0;
      margin: 0; padding: 10px; border-radius: 22px;
      flex-direction: column; align-items: stretch; gap: 2px; z-index: 60;
    }
    .site-header.is-open .nav-links {
      display: flex;
      background: #160c0c;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 18px 40px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(22px) saturate(1.6);
      -webkit-backdrop-filter: blur(22px) saturate(1.6);
    }
    .menu-btn, .nav-links > li > a { width: 100%; justify-content: space-between; }
    .submenu {
      position: static; min-width: 0; margin: 0; padding: 0 0 4px 8px;
      background: transparent; border: 0; box-shadow: none; backdrop-filter: none;
    }
    .get { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chev { transition: none; }
  }
</style>
