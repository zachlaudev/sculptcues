---
const path = Astro.url.pathname;
const links = [
  { href: '/#notify', label: 'Subscribe' },
  { href: '/blog/', label: 'Blogs', on: path.startsWith('/blog') },
  { href: '/support/', label: 'Support', on: path.startsWith('/support') },
  { href: '/#get-app', label: 'Get App', cta: true },
];
---
<header class="site-header">
  <nav class="bar glass wrap" aria-label="Main">
    <a href="/" class="brand" aria-label="Sculpt Cues home">
      <img src="/img/icon.webp" alt="" width="30" height="30" />
      <span class="wordmark">sculpt cues</span>
    </a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={[{ on: l.on, cta: l.cta }]}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 14px; z-index: 50; }
  .bar {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    border-radius: 28px; padding: 8px 8px 8px 12px;
    background: rgba(20, 10, 10, 0.88);
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { border-radius: 8px; }
  .brand .wordmark { font-size: 21px; color: #fff; }
  ul { display: flex; gap: 4px; list-style: none; margin-left: auto; flex-wrap: wrap; align-items: center; }
  ul a {
    display: block; padding: 9px 14px; border-radius: 999px; font-size: 14px;
    color: var(--muted); text-decoration: none;
  }
  ul a:hover, ul a.on { color: #fff; background: rgba(255, 247, 240, 0.12); }
  ul a.cta {
    background: var(--ember-gradient); color: #fff; font-weight: 600;
    padding: 10px 16px;
  }
  ul a.cta:hover { color: #fff; }
  @media (max-width: 760px) {
    ul { margin-left: 0; width: 100%; }
  }
</style>
