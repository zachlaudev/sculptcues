---
import { impact, type Scores } from '../lib/impact';
interface Props { scores: Scores; caption?: string }
const { scores, caption } = Astro.props;
const { bars, caution } = impact(scores);
---
<div class="chart">
  {caption && <p class="caption">{caption}</p>}
  {caution && <p class="caution">{caution}</p>}
  {bars.map((bar) => (
    <div class:list={['bar-row', { hot: bar.overwork }]}>
      <span>{bar.label}</span>
      <div class="track" role="img" aria-label={`${bar.label} ${bar.value}`}><i style={`width:${bar.width}%`}></i></div>
    </div>
  ))}
</div>
<style>
  .caption {
    width: fit-content; margin: 0 0 6px auto;
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted);
    background: rgba(255, 255, 255, 0.06); border-radius: 999px; padding: 3px 8px;
  }
  .caution {
    font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: #ffb4a2;
    background: rgba(244, 70, 38, 0.14); border: 1px solid rgba(244, 70, 38, 0.35);
    padding: 4px 8px; border-radius: 8px; margin-bottom: 6px;
  }
  .bar-row { display: grid; grid-template-columns: 62px 1fr; align-items: center; gap: 6px; margin: 2px 0; font-size: 11px; color: var(--muted); }
  .track { height: 5px; border-radius: 99px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
  .track i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--rust), var(--ember), var(--peach)); }
  .hot span { color: #ffb4a2; }
  .hot .track i { background: linear-gradient(90deg, var(--ember), #ffb4a2); }
</style>
