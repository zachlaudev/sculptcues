---
// Recreated from LibraryView: pinned header, search, area chips, photo folders.
// Per-folder counts are omitted. movements.json was not in the reference package.
const areas = [
  { title: 'glutes', image: '/img/glutes.webp' },
  { title: 'abs', image: '/img/core.webp' },
  { title: 'legs', image: '/img/legs.webp' },
  { title: 'arms', image: '/img/arms.webp' },
  { title: 'back', image: '/img/back.webp' },
  { title: 'chest', image: '/img/chest.webp' },
];
---
<div class="lib" data-screen="library">
  <div class="head">
    <p class="kicker">280+ movements</p>
    <div class="title">
      <h3>Library</h3>
      <span class="new">+ New</span>
    </div>
  </div>
  <div class="search" aria-hidden="true">Search movements or equipment</div>
  <div class="areas" aria-hidden="true">
    <span class="on">All</span>
    <span>Glutes</span>
    <span>Abs</span>
    <span>Legs</span>
    <span>Arms</span>
  </div>
  <div class="grid">
    {areas.map((area) => (
      <div class="folder" style={`background-image:url('${area.image}')`}>
        <b>{area.title}</b>
      </div>
    ))}
  </div>
</div>

<style>
  .lib { display: flex; flex-direction: column; gap: 8px; height: 100%; }
  .head .kicker { font-size: 10px; letter-spacing: 0.16em; }
  .title { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .title h3 { font-size: 28px; letter-spacing: -0.045em; }
  .new {
    font-size: 11px; font-weight: 500; padding: 6px 10px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 247, 240, 0.07);
  }
  .search, .areas span {
    font-size: 11px; color: var(--faint);
  }
  .search {
    border-radius: 12px; padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 247, 240, 0.07);
  }
  .areas { display: flex; gap: 6px; overflow: hidden; }
  .areas span {
    border-radius: 999px; padding: 5px 8px; white-space: nowrap;
    background: rgba(255, 255, 255, 0.07); color: var(--muted);
  }
  .areas .on { background: var(--ember-gradient); color: #fff; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .folder {
    aspect-ratio: 3 / 2; border-radius: 16px; background-size: cover; background-position: center;
    display: flex; align-items: flex-end; padding: 8px 10px; position: relative; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .folder::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgba(0, 0, 0, 0.4));
  }
  .folder b {
    position: relative; z-index: 1; font-family: var(--brand); font-weight: 900;
    font-size: 13px; letter-spacing: -0.02em; color: #fff; text-transform: lowercase;
  }
</style>
