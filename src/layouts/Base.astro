---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetaPixel from '../components/MetaPixel.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Logo and a short legal footer. Used by the ads landing page. */
  landing?: boolean;
}
const { title, description = SITE.description, image = '/img/og.jpg', type = 'website', noindex = false, landing = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} – ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#140a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Outfit-Black.woff2" as="font" type="font/woff2" crossorigin />
    <MetaPixel />
    <link rel="alternate" type="application/rss+xml" title="Sculpt Cues journal" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <div class="wash" aria-hidden="true"></div>
    {landing ? (
      <header class="land-bar">
        <a href="/" class="brand" aria-label="Sculpt Cues">
          <img src="/img/icon.webp" alt="" width="32" height="32" />
          <span class="wordmark">sculpt cues</span>
        </a>
      </header>
    ) : <Header />}
    <main><slot /></main>
    {landing ? (
      <footer class="land-foot wrap">
        <nav aria-label="Footer">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/support/">Support</a>
          <a class="ig" href={SITE.instagram} target="_blank" rel="noopener" aria-label="Sculpt Cues on Instagram">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </nav>
        <p>© {new Date().getFullYear()} Sculpt Cues. iPhone and App Store are trademarks of Apple Inc.</p>
      </footer>
    ) : <Footer />}
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
<style>
  .land-bar { padding: 22px 0 0; display: flex; justify-content: center; }
  .land-bar .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .land-bar img { border-radius: 8px; }
  .land-bar .wordmark { font-size: 22px; color: #fff; }
  .land-foot { border-top: 1px solid var(--line); margin-top: 24px; padding: 28px 0 36px; text-align: center; }
  .land-foot nav { display: flex; justify-content: center; align-items: center; gap: 22px; flex-wrap: wrap; }
  .land-foot a { color: var(--muted); text-decoration: none; font-size: 14px; }
  .land-foot a:hover { color: var(--cream); }
  .land-foot .ig { display: inline-flex; align-items: center; }
  .land-foot p { margin-top: 16px; color: var(--faint); font-size: 12px; }
</style>
