---
import Base from './Base.astro';
import { breadcrumbList, pageUrl } from '../lib/schema';
import { SITE } from '../site';

interface Props {
  /** Document title before " · Sculpt Cues". */
  title: string;
  description: string;
  kicker: string;
  heading: string;
  crumb: string;
  schema?: object[];
}
const { title, description, kicker, heading, crumb, schema = [] } = Astro.props;
---
<Base
  title={title}
  description={description}
  includeApp
  schema={[
    breadcrumbList([
      { name: 'Home', url: pageUrl('/') },
      { name: crumb, url: pageUrl(Astro.url.pathname) },
    ]),
    ...schema,
  ]}
>
  <div class="wrap guide">
    <p class="kicker">{kicker}</p>
    <h1>{heading}</h1>
    <p class="lede">{description}</p>
    <slot />
    <p class="guide-links">
      <a class="store" href={SITE.appStoreUrl}>Download Sculpt Cues on the App Store</a>
      <a class="home" href="/">Sculpt Cues homepage</a>
    </p>
  </div>
</Base>
<style>
  .guide { padding: 70px 0 20px; }
  .guide h1 { margin: 10px 0 16px; font-size: clamp(34px, 5vw, 58px); max-width: 16em; }
  .guide .lede { margin-bottom: 32px; }
  .guide :global(.stack) { display: grid; gap: 14px; max-width: 760px; }
  .guide :global(.stack .card) { border-radius: 22px; padding: 22px 24px; }
  .guide :global(.stack h2) { font-size: clamp(22px, 2.6vw, 30px); margin-bottom: 8px; }
  .guide :global(.stack p) { color: var(--muted); }
  .guide :global(.flow-list) { list-style: none; display: grid; gap: 12px; max-width: 760px; }
  .guide :global(.flow-list li) { border-radius: 22px; padding: 18px 22px; }
  .guide :global(.flow-list h2) { font-size: clamp(22px, 2.6vw, 28px); margin-bottom: 4px; }
  .guide :global(.flow-list p) { color: var(--muted); font-size: 15px; }
  .guide-links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 32px; font-size: 16px; }
  .store { color: var(--peach); text-underline-offset: 3px; }
  .home { color: var(--muted); text-decoration: none; }
  .home:hover { color: var(--cream); }
</style>
