---
import Base from './Base.astro';
import { breadcrumbList, pageUrl } from '../lib/schema';
interface Props {
  title: string;
  kicker?: string;
  description?: string;
  updated?: string;
  noindex?: boolean;
  schema?: object[];
  breadcrumb?: boolean;
}
const { title, kicker, description, updated, noindex = false, schema = [], breadcrumb = true } = Astro.props;
const nodes = [
  ...(breadcrumb
    ? [breadcrumbList([
        { name: 'Home', url: pageUrl('/') },
        { name: title, url: pageUrl(Astro.url.pathname) },
      ])]
    : []),
  ...schema,
];
---
<Base title={title} description={description} noindex={noindex} schema={nodes}>
  <slot name="head" slot="head" />
  <div class="wrap page">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {updated && <p class="muted updated">Last updated {updated}</p>}
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  .page { padding: 70px 0 40px; }
  h1 { margin: 10px 0 10px; font-size: clamp(38px, 5.4vw, 60px); }
  .updated { margin-bottom: 36px; font-size: 14px; }
</style>
