---
import Base from './Base.astro';
interface Props { title: string; kicker?: string; description?: string; updated?: string }
const { title, kicker, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <slot name="head" slot="head" />
  <div class="wrap page">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {updated && <p class="muted updated">Last updated {updated}</p>}
    <div class="prose"><slot /></div>
  </div>
</Base>
<style>
  .page { padding: 70px 0 40px; }
  h1 { margin: 10px 0 10px; font-size: clamp(38px, 5.4vw, 60px); }
  .updated { margin-bottom: 36px; font-size: 14px; }
</style>
