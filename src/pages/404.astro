---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="wrap nf">
    <p class="kicker">404</p>
    <h1>Lost the beat.</h1>
    <p class="lede">That page doesn't exist. Head back home and we'll cue you in.</p>
    <a class="btn btn-primary" href="/">Back home</a>
  </div>
</Base>
<style>
  .nf { padding: 120px 0; text-align: center; }
  .nf h1 { margin: 10px 0 16px; }
  .nf .lede { margin: 0 auto 30px; }
</style>
