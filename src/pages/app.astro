---
import Base from '../layouts/Base.astro';
import CueCoach from '../components/CueCoach.astro';

const store = 'https://apps.apple.com/app/apple-store/id6831637468?pt=128746925&ct=site-app&mt=8';
const description = 'Plan better sculpt classes.';
const rewrite = `(function () {
  var raw = new URLSearchParams(location.search).get('utm_campaign') || '';
  var ct = raw.toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 40) || 'site-app';
  var href = 'https://apps.apple.com/app/apple-store/id6831637468?pt=128746925&ct=' + ct + '&mt=8';
  document.querySelectorAll('[data-store-campaign]').forEach(function (link) {
    link.setAttribute('href', href);
  });
})();`;
---
<Base landing title="For all sculpt instructors" description={description}>
  <meta slot="head" name="robots" content="noindex" />

  <section class="hero wrap">
    <img class="logo" src="/img/icon.webp" alt="Sculpt Cues" width="76" height="76" />
    <h1>For all sculpt instructors.</h1>
    <p class="sub">Plan better sculpt classes.</p>
    <a class="store" data-app-store data-store-campaign href={store}>
      <img src="/img/app-store-badge-white.svg" alt="Download on the App Store" width="260" height="87" />
    </a>
  </section>

  <section class="wrap features" aria-label="What you can do in Sculpt Cues">
    <article class="card glass block">
      <div class="shot">
        <img src="/img/hero-library.webp" alt="Library: 284 movements in body-area folders" width="414" height="900" />
      </div>
      <div>
        <p class="kicker">Flows</p>
        <h2>Your class, segment by segment.</h2>
        <p>Plan a Flow from the 284-movement library. Organise your Flows in custom folders.</p>
      </div>
    </article>

    <article class="card glass block">
      <div class="shot">
        <img src="/img/hero-intensity.webp" alt="Intensity chart for the Arms and Core flow" width="414" height="900" />
      </div>
      <div>
        <p class="kicker">Smart analysis</p>
        <h2>See which part is carrying the class.</h2>
        <p>The intensity chart scores the work across seven body parts and flags overload.</p>
      </div>
    </article>

    <article class="card glass block">
      <div class="coach">
        <CueCoach bpm={120} outer={168} inner={90} compact />
      </div>
      <div>
        <p class="kicker">Cue Coach</p>
        <h2>Finds the beat. Keeps you on it.</h2>
        <p>Cue Coach listens to any song playing out loud and gives you live BPM. Audio is not recorded.</p>
      </div>
    </article>
  </section>

  <section class="wrap train">
    <p class="card glass line">Training to teach sculpt? Plan your first classes with confidence.</p>
  </section>

  <section class="wrap close">
    <a class="store" data-app-store data-store-campaign href={store}>
      <img src="/img/app-store-badge-white.svg" alt="Download on the App Store" width="260" height="87" />
    </a>
  </section>

  <script is:inline set:html={rewrite}></script>
</Base>

<style>
  .hero {
    min-height: calc(100svh - 168px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 36px 0 28px;
  }
  .logo { width: 76px; height: 76px; border-radius: 18px; margin-bottom: 22px; box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35); }
  .hero h1 { font-size: clamp(38px, 6vw, 68px); max-width: 14ch; }
  .sub {
    margin-top: 14px;
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .store { display: inline-block; margin-top: 32px; line-height: 0; }
  .store img { width: min(260px, 78vw); height: auto; }
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 12px;
    padding-bottom: 8px;
  }
  .block { border-radius: 22px; padding: 14px 14px 22px; display: flex; flex-direction: column; gap: 16px; }
  .shot, .coach {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: rgba(20, 10, 10, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .coach { display: grid; place-items: center; padding: 12px 8px; }
  .block h2 { font-size: clamp(24px, 2vw, 30px); margin: 8px 0 8px; }
  .block p:last-child { color: var(--muted); font-size: 15px; }
  .train { padding-top: 28px; padding-bottom: 8px; }
  .line {
    border-radius: 22px;
    padding: 28px 24px;
    text-align: center;
    font-size: clamp(20px, 2.4vw, 28px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }
  .close { display: flex; justify-content: center; padding-top: 36px; padding-bottom: 20px; }
  @media (max-width: 900px) {
    .hero { min-height: auto; padding-top: 48px; }
    .features { grid-template-columns: 1fr; }
    .shot, .coach { aspect-ratio: 5 / 4; max-height: 420px; }
  }
</style>
