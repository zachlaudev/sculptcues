---
import Base from '../../layouts/Base.astro';
import AppStoreButton from '../../components/AppStoreButton.astro';
import { render } from 'astro:content';
import { article, breadcrumbList, faqPage, pageUrl } from '../../lib/schema';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const canonical = pageUrl(Astro.url.pathname);
const posts = await getPosts();
const related = posts
  .filter((item) => item.id !== post.id)
  .map((item) => ({
    item,
    score: item.data.tags.filter((tag) => d.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score || b.item.data.pubDate.valueOf() - a.item.data.pubDate.valueOf())
  .slice(0, 2)
  .map((entry) => entry.item);
const image = d.image ?? '/img/og.jpg';
const schema = [
  article({
    title: d.title,
    description: d.description,
    url: canonical,
    datePublished: d.pubDate,
    dateModified: d.updatedDate ?? d.pubDate,
    image,
    keywords: d.tags,
  }),
  breadcrumbList([
    { name: 'Home', url: pageUrl('/') },
    { name: 'Journal', url: pageUrl('/blog/') },
    { name: d.title, url: canonical },
  ]),
  ...(d.faq?.length ? [faqPage(d.faq)] : []),
];
---
<Base title={d.title} description={d.description} image={image} type="article" schema={schema} published={d.pubDate} modified={d.updatedDate ?? d.pubDate}>
  <article class="wrap">
    <header>
      <a class="back" href="/blog/">← Journal</a>
      <p class="kicker">{fmt(d.pubDate)}{d.tags.length > 0 && ` · ${d.tags.join(' · ')}`}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </header>
    {d.image && <img class="cover" src={d.image} alt={d.imageAlt || d.title} />}
    <div class="prose"><Content /></div>
    {related.length > 0 && (
      <nav class="related" aria-label="Related posts">
        <h2>More from the Journal</h2>
        <ul>
          {related.map((item) => (
            <li><a href={`/blog/${item.id}/`}>{item.data.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <aside class="card glass cta">
      <div>
        <p class="kicker">Sculpt Cues</p>
        <h3>Plan sculpt classes.</h3>
        <p class="muted">A movement library, Flows you can share, and Cue Coach when you want the beat.</p>
      </div>
      <AppStoreButton campaign={`site-blog-${post.id}`} />
    </aside>
  </article>
</Base>

<style>
  article { padding: 60px 0 40px; }
  header { max-width: 780px; margin-bottom: 36px; }
  .back { display: inline-block; color: var(--muted); text-decoration: none; font-size: 14px; margin-bottom: 26px; }
  .back:hover { color: var(--cream); }
  h1 { font-size: clamp(36px, 5.4vw, 60px); margin: 12px 0 18px; }
  .cover { border-radius: 22px; width: 100%; max-height: 520px; object-fit: cover; margin-bottom: 40px; }
  .related { margin-top: 56px; max-width: 680px; }
  .related h2 { font-size: 30px; margin-bottom: 14px; }
  .related ul { list-style: none; display: grid; gap: 10px; }
  .related a { color: var(--cream); text-decoration: none; }
  .related a:hover { color: var(--peach); }
  .cta { margin-top: 28px; max-width: 680px; border-radius: 22px; padding: 26px; display: flex; gap: 20px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .cta h3 { margin: 6px 0 6px; }
</style>
