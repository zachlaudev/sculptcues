---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import LibraryScreen from '../components/LibraryScreen.astro';
import FlowsScreen from '../components/FlowsScreen.astro';
import ProfileScreen from '../components/ProfileScreen.astro';
import CueCoach from '../components/CueCoach.astro';
import { getPosts } from '../lib/posts';
import { PRICES } from '../site';

const posts = (await getPosts()).slice(0, 3);
const areas = [
  { title: 'glutes', image: '/img/glutes.webp' },
  { title: 'abs', image: '/img/core.webp' },
  { title: 'legs', image: '/img/legs.webp' },
  { title: 'arms', image: '/img/arms.webp' },
  { title: 'back', image: '/img/back.webp' },
  { title: 'chest', image: '/img/chest.webp' },
];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
  <section class="hero">
    <div class="hero-img" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">For sculpt teachers</p>
        <h1 class="wordmark big">sculpt cues</h1>
        <p class="tag">Plan the class. Teach it your way.</p>
        <p class="lede">Build the class from a large movement library that keeps growing. Sculpt Cues suggests what could come next, then keeps the Flow in folders you can edit and send to another teacher. Cue Coach is there when you want the beat.</p>
        <div class="ctas">
          <a class="btn btn-primary lg" href="#get-app">Get App</a>
          <a class="btn btn-ghost glass" href="#notify">Subscribe</a>
        </div>
        <p class="fine">iPhone app. Not on the App Store yet.</p>
      </div>
      <div class="hero-phone">
        <Phone width={300}>
          <LibraryScreen />
        </Phone>
        <p class="caption">Library screen, recreated from the app. Not a screenshot.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <p class="kicker">Library</p>
        <h2>A growing library of 280+ movements.</h2>
        <p class="lede">The same line the app uses. Movements sit in six folders: glutes, abs, legs, arms, back and chest. Search by name, equipment or another name teachers use. Add your own, edit a catalogue movement, or duplicate one and restore the original later.</p>
        <ul class="ticks">
          <li>Search, body-area folders, and a New movement button</li>
          <li>Your edits and photos stay on the iPhone</li>
          <li>The catalogue is meant to keep growing</li>
        </ul>
      </div>
      <div class="folders" aria-label="Library folders">
        {areas.map((area) => (
          <div class="folder" style={`background-image:url('${area.image}')`}>
            <b class="wordmark">{area.title}</b>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap narrow">
      <p class="kicker">While you build</p>
      <h2>A suggestion for what to teach next.</h2>
      <p class="lede">Each movement can be scored from 0 to 5 on core, glutes, legs, arms, shoulders, back and chest. Sculpt Cues adds the scores for the class so far. When one part has at least 8 points and 40% of the total, the segment says so and offers up to three next movements.</p>
      <ul class="ticks">
        <li>The caution names the part, such as “Caution: possible glutes overwork”</li>
        <li>A reason can be the same position, a pair, a progression, or a counter</li>
        <li>Hold and drag to reorder a segment. Move a segment up or down</li>
      </ul>
    </div>
  </section>

  <section class="tight">
    <div class="wrap split">
      <div>
        <p class="kicker">Flows</p>
        <h2>One class, song by song.</h2>
        <p class="lede">A Flow is the class. Each segment is one song, with the movements in order and a note if you want one. Five starter classes ship with the app. Folders, sort, and duplicate are there when the list grows.</p>
        <ul class="ticks">
          <li>Sort by recently edited, name, length or date created</li>
          <li>Teach opens an overview of the names, or one segment at a time</li>
          <li>Starter classes include a right-side segment and a matching left-side segment. You write that note yourself</li>
        </ul>
      </div>
      <div>
        <Phone width={300}>
          <FlowsScreen />
        </Phone>
        <p class="caption">Flows list, from the five starter classes. Recreated, not a screenshot.</p>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap split flip">
      <div>
        <p class="kicker">Yours, and theirs</p>
        <h2>Personalise a movement. Send the class on.</h2>
        <p class="lede">Rename a movement, add notes and recovery, moderate and peak counts, or use your own photo. Share a Flow as a file or a link. Movements you created travel with it and are added on the other teacher’s iPhone. Catalogue movements they already have are not sent again.</p>
      </div>
      <div>
        <Phone width={300}>
          <ProfileScreen />
        </Phone>
        <p class="caption">Profile screen, recreated from the app. No sample teacher is shown.</p>
      </div>
    </div>
  </section>

  <section class="tight" id="cue-coach">
    <div class="wrap cue-layout">
      <div>
        <p class="kicker">Cue Coach</p>
        <h2>The beat, when you want it.</h2>
        <p class="lede">On the iPhone, Cue Coach listens to music playing in the room and locks a tempo. Half time holds a word for two beats, single time changes every beat, and double time changes halfway through the beat. The count dots still mark every beat. This page only plays that locked circle on a steady clock.</p>
      </div>
      <CueCoach bpm={120} outer={220} inner={118} />
    </div>
  </section>

  {posts.length > 0 && (
    <section class="tight">
      <div class="wrap">
        <div class="section-head row">
          <div>
            <p class="kicker">Blogs</p>
            <h2>For the teacher's notebook.</h2>
          </div>
          <a class="btn btn-ghost glass" href="/blog/">All posts</a>
        </div>
        <div class="three">
          {posts.map((p) => (
            <a class="post card glass" href={`/blog/${p.id}/`}>
              <p class="kicker">{fmt(p.data.pubDate)}</p>
              <h3>{p.data.title}</h3>
              <p class="muted">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="get-app">
    <div class="wrap">
      <div class="section-head center">
        <p class="kicker">Get App</p>
        <h2>Not on the App Store yet.</h2>
        <p class="lede">There is no download link until the iPhone app is released. Join the list and we will write when it is ready to install. The paywall in the app offers Monthly, Annual with a free trial, and Lifetime.</p>
      </div>
      <div class="prices">
        {PRICES.map((p) => (
          <div class="price card glass">
            <p class="kicker">{p.name}</p>
            <p class="amount">{p.price} <small>{p.per}</small></p>
            <p class="muted">{p.note}</p>
          </div>
        ))}
      </div>
      <p class="fine center">These are the prices already published for the app. The App Store will set the amount you pay, in your local currency, once the app is listed. Nothing on this page takes payment.</p>
      <div class="center" style="margin-top:22px">
        <a class="btn btn-primary" href="#notify">Join the list</a>
      </div>
    </div>
  </section>

  <section id="notify" class="tight">
    <div class="wrap">
      <div class="card glass notify">
        <p class="kicker">Subscribe</p>
        <h2>Subscribe to our updates.</h2>
        <p class="lede">New movements, sample Flows and launch news. No spam, unsubscribe any time.</p>
        <form id="signup" novalidate>
          <input type="email" name="email" placeholder="Email" required autocomplete="email" class="glass" aria-label="Email" />
          <button class="btn btn-primary" type="submit">Subscribe</button>
        </form>
        <p class="form-msg" role="status" aria-live="polite"></p>
      </div>
    </div>
  </section>
</Base>

<script>
  const SUPABASE_URL = 'https://npabobxcbcqnpncwergk.supabase.co';
  const KEY = 'sb_publishable_dE9JKyxLO3ce0YQDWpsVXg_XHIGTRCb';
  const form = document.getElementById('signup') as HTMLFormElement;
  const msg = document.querySelector('.form-msg') as HTMLElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.email as HTMLInputElement).value.trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please enter a valid email.'; return; }
    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true; msg.textContent = '';
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/email_signups`, {
        method: 'POST',
        headers: { apikey: KEY, Authorization: `Bearer ${KEY}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({ email, source: 'website', consented_at: new Date().toISOString() }),
      });
      if (res.ok || res.status === 409) { form.reset(); msg.textContent = "You're on the list. Thank you!"; }
      else throw new Error(String(res.status));
    } catch {
      msg.textContent = 'Something went wrong. Please try again.';
    } finally { btn.disabled = false; }
  });
</script>

<style>
  .hero { position: relative; padding: 70px 0 80px; display: flex; align-items: center; margin-top: -74px; padding-top: 140px; }
  .hero-img {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(90deg, var(--ink) 0%, rgba(20, 10, 10, 0.92) 34%, rgba(20, 10, 10, 0.55) 70%, rgba(20, 10, 10, 0.72) 100%),
      linear-gradient(180deg, rgba(20, 10, 10, 0.15) 50%, var(--ink) 100%),
      url('/img/hero.webp') 78% 38% / cover no-repeat;
  }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 40px; align-items: center; }
  .wordmark.big { font-size: clamp(64px, 11vw, 120px); color: #fff; margin: 10px 0 8px; letter-spacing: -0.035em; }
  .tag { font-size: clamp(20px, 2.4vw, 26px); font-weight: 500; letter-spacing: -0.03em; margin-bottom: 16px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .lg { padding: 17px 30px; font-size: 17px; }
  .fine { margin-top: 14px; font-size: 13px; color: var(--faint); }
  .hero-phone, .split > div:last-child { display: flex; flex-direction: column; align-items: center; }
  .caption { margin-top: 10px; font-size: 12px; color: var(--faint); text-align: center; max-width: 280px; }

  .split { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .split.flip { grid-template-columns: 0.9fr 1.1fr; }
  .split.flip > div:first-child { order: 2; }
  section.tight { padding-top: clamp(28px, 5vw, 56px); }
  .narrow { max-width: 760px; }
  .ticks { list-style: none; margin-top: 22px; display: grid; gap: 10px; }
  .ticks li { padding-left: 22px; position: relative; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--ember); }

  .folders { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .folder {
    aspect-ratio: 3 / 2; border-radius: 18px; background-size: cover; background-position: center;
    display: flex; align-items: flex-end; padding: 12px; position: relative; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .folder::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.45)); }
  .folder b { position: relative; z-index: 1; font-size: 22px; color: #fff; }

  .cue-layout { display: grid; grid-template-columns: 1fr minmax(280px, 420px); gap: 40px; align-items: center; }
  .card { border-radius: 22px; padding: 26px; }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .section-head.row { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .post { text-decoration: none; display: block; }
  .post:hover { border-color: rgba(255, 114, 90, 0.5); }
  .post h3 { margin: 10px 0 8px; }

  .center { text-align: center; }
  .center .lede { margin-inline: auto; }
  .prices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 900px; margin: 0 auto; }
  .price { text-align: center; padding: 28px 18px; }
  .amount { font-size: 36px; font-weight: 500; letter-spacing: -0.04em; margin: 8px 0 4px; }
  .amount small { font-size: 15px; color: var(--muted); letter-spacing: 0; }
  p.fine.center { margin: 18px auto 0; max-width: 40em; }

  .notify { text-align: center; padding: clamp(32px, 6vw, 64px); }
  .notify h2 { margin: 10px 0 12px; }
  .notify .lede { margin: 0 auto 26px; }
  form { display: flex; gap: 10px; max-width: 480px; margin: 0 auto; }
  form input { flex: 1; border-radius: 999px; padding: 15px 20px; font-size: 15px; color: var(--cream); font-family: inherit; outline: none; }
  form input::placeholder { color: var(--faint); }
  .form-msg { margin-top: 14px; min-height: 1.5em; font-size: 14px; color: var(--peach); }

  @media (max-width: 900px) {
    .hero-grid, .split, .split.flip, .cue-layout, .three, .prices { grid-template-columns: 1fr; }
    .split.flip > div:first-child { order: 0; }
    .hero { min-height: auto; }
    .folders { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    form { flex-direction: column; }
  }
</style>
